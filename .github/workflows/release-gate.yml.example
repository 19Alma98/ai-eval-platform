# Example workflow: run RAG exam + quality gate in one step (pytest-like).
# This file is intentionally named *.yml.example so GitHub Actions does not run it.
# Copy to release-gate.yml (or into a consumer repo) and adapt.
#
# Exit codes from `opengrade evaluate` / `opengrade check`:
#   0 pass | 1 gate failed | 2 config error | 3 infra error
#
# Prefer `from_experiment` in opengrade.yaml once a gold exam exists on a remote
# OpenGrade server. For bootstrap / fully ephemeral CI, omit api_base_url so the
# CLI starts embedded API+SQLite and use dataset + metrics in the YAML.

name: Quality gate example

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

jobs:
  rag-quality-gate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install uv
        uses: astral-sh/setup-uv@v4
        with:
          version: "0.8.4"

      - name: Set up Python
        run: uv python install 3.12

      - name: Install app + OpenGrade CLI
        run: |
          uv sync
          # Consumer repos: uv add 'opengrade-ai[ui]'  (or pip install)

      - name: Run evaluate + gate
        env:
          LLM_API_KEY: ${{ secrets.LLM_API_KEY }}
          # Optional remote server (otherwise embedded SQLite):
          # OPENGRADE uses api_base_url from opengrade.yaml when set
        run: |
          uv run opengrade evaluate \
            --config opengrade.yaml \
            --name "ci-${GITHUB_SHA::7}" \
            --version "$GITHUB_SHA"

      # Moving baseline (needs a persistent server); promotes only on push to main:
      # - name: Run evaluate + gate (alias baseline)
      #   env:
      #     LLM_API_KEY: ${{ secrets.LLM_API_KEY }}
      #     PROMOTE: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' && '--promote main' || '' }}
      #   run: |
      #     uv run opengrade evaluate \
      #       --config opengrade.yaml \
      #       --name "ci-${GITHUB_SHA::7}" \
      #       --version "$GITHUB_SHA" \
      #       --baseline alias:main \
      #       $PROMOTE

      # Standalone check against an existing experiment (optional second job):
      # - run: opengrade check --policy opengrade.yaml --base-url … --project-id … --experiment-id …
