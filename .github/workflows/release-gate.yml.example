# Example workflow: fail the job when an OpenGrade release gate fails.
# This file is intentionally named *.yml.example so GitHub Actions does not run it.
# Copy to release-gate.yml (or into a consumer repo) and adapt.
# Requires a reachable OpenGrade API with evaluated experiment runs already available.
#
# Exit codes from `opengrade check`:
#   0 pass | 1 gate failed | 2 config error | 3 infra error

name: Release gate example

on:
  workflow_dispatch:
    inputs:
      project_id:
        description: OpenGrade project UUID
        required: true
      experiment_id:
        description: Candidate experiment UUID
        required: true
      baseline_experiment_id:
        description: Baseline experiment UUID (optional if set on experiment)
        required: false
      api_base_url:
        description: OpenGrade API base URL
        required: true
        default: http://localhost:8000

jobs:
  release-gate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install uv
        uses: astral-sh/setup-uv@v4
        with:
          version: "0.8.4"

      - name: Set up Python
        run: uv python install 3.12

      - name: Install opengrade-ai-server (CLI)
        working-directory: backend
        run: uv sync

      - name: Run release check
        working-directory: backend
        env:
          OPENGRADE_BASE_URL: ${{ inputs.api_base_url }}
          OPENGRADE_PROJECT_ID: ${{ inputs.project_id }}
          OPENGRADE_EXPERIMENT_ID: ${{ inputs.experiment_id }}
          OPENGRADE_BASELINE_ID: ${{ inputs.baseline_experiment_id }}
        run: |
          ARGS=(
            check
            --policy ../examples/opengrade.yaml
            --base-url "$OPENGRADE_BASE_URL"
            --project-id "$OPENGRADE_PROJECT_ID"
            --experiment-id "$OPENGRADE_EXPERIMENT_ID"
          )
          if [ -n "${OPENGRADE_BASELINE_ID:-}" ]; then
            ARGS+=(--baseline-experiment-id "$OPENGRADE_BASELINE_ID")
          fi
          uv run opengrade "${ARGS[@]}"
