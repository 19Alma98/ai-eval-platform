# Copy to backend/.env and adjust as needed:
#   cp .env.example .env

# Database (Compose publishes Postgres on 127.0.0.1:5434 only)
DATABASE_URL=postgresql+asyncpg://opengrade:opengrade@localhost:5434/opengrade

APP_HOST=0.0.0.0
APP_PORT=8000

# Store span text: input/output values, LLM prompts/messages and completions, retrieved
# document text (on by default). Live scoring and LLM judges need it. false = redact
# that text at ingestion; timings, tokens, cost, metadata and document ids/titles/scores
# are kept, so retrieval metrics still work and judges that need text are SKIPPED.
CONTENT_CAPTURE_ENABLED=true

# Reverse proxy (Docker entrypoint / opengrade ui without --reload)
FORWARDED_ALLOW_IPS=*
SHUTDOWN_GRACE_SECONDS=30

# OTLP ingestion body size limit (bytes)
OTLP_MAX_BODY_BYTES=4194304

# OTLP backpressure (per process; single API replica assumed)
OTLP_RATE_LIMIT_PER_SECOND=50
OTLP_MAX_INFLIGHT=32
OTLP_MAX_PENDING_SCORES=200
OTLP_RETRY_AFTER_SECONDS=1

# Server-side alerts (Production → Alerts). Evaluated every interval in the API process.
# ALERTS_ENABLED=true
# ALERTS_INTERVAL_SECONDS=60
# Default webhook for rules without their own (Slack incoming webhook or any JSON endpoint)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# Public URL of the UI, for links in notifications
# PUBLIC_BASE_URL=https://opengrade.internal

# Retention of production data (traces, live answers, scores, alert events), in days.
# Projects can override it; unset keeps everything. Purge runs every interval.
# RETENTION_DAYS=90
# RETENTION_INTERVAL_HOURS=24

# App-wide JSON request body buffer cap (bytes). Middleware rejects larger JSON
# before parsing. Raise this if you raise OTLP_MAX_BODY_BYTES for JSON OTLP.
JSON_MAX_BODY_BYTES=4194304

# Dataset multipart import file size cap (bytes)
DATASET_IMPORT_MAX_BYTES=4194304

# --- LLM judges (LiteLLM) ---
# Cloud example (Google AI Studio; default when LLM_MODEL is unset):
LLM_MODEL=gemini/gemini-3.8-flash
LLM_API_KEY=

# Local Ollama example:
# LLM_MODEL=ollama/gemma4:e2b
# From Docker Compose API use host.docker.internal (extra_hosts in compose).
# From a host-local API process use http://localhost:11434 instead.
# LLM_API_BASE=http://host.docker.internal:11434
# LLM_API_KEY=

# Local Ollama cold-start can exceed 60s on small hosts
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8
