# Copy to backend/.env and adjust as needed:
#   cp .env.example .env

# Database (Compose publishes Postgres on host port 5434)
DATABASE_URL=postgresql+asyncpg://aiobs:aiobs@localhost:5434/aiobs

APP_HOST=0.0.0.0
APP_PORT=8000

# Capture prompt/completion content on traces (off by default)
CONTENT_CAPTURE_ENABLED=false

# OTLP ingestion body size limit (bytes)
OTLP_MAX_BODY_BYTES=4194304

# --- LLM judges (LiteLLM) ---
# Cloud example:
# LLM_MODEL=anthropic/claude-sonnet-5
# LLM_API_KEY=sk-...

# Local Ollama example:
LLM_MODEL=ollama/gemma4:e2b
LLM_API_BASE=http://localhost:11434
# LLM_API_KEY=

# Local Ollama cold-start can exceed 60s on small hosts
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8
