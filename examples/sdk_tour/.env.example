# Copy to .env and adjust: the tour scripts read it automatically.

# Where the OpenGrade platform runs (`uv run opengrade ui` or `docker compose up`).
OPENGRADE_TRACKING_URI=http://localhost:8000
# Project for traces, datasets and experiments (created on first run).
OPENGRADE_PROJECT=nimbus-support

# Model used by the assistant. "fake-small" / "fake-large" run offline; any other name
# is called through an OpenAI-compatible API (needs `uv sync --extra llm`).
TOUR_MODEL=fake-large
# Models compared by 03_compare_architectures.py (comma-separated).
TOUR_COMPARE_MODELS=fake-small,fake-large

# OpenAI-compatible endpoint for real models (Ollama by default; OpenAI: https://api.openai.com/v1).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# 1 = the platform has an LLM judge configured (LLM_MODEL / LLM_API_KEY in backend/.env):
# the scripts add groundedness, correctness, citation_accuracy and a custom LLM judge.
TOUR_LLM_JUDGES=0

# Release and environment stamped on the traces of 01_tracing.py.
TOUR_APP_VERSION=1.4.0
TOUR_APP_ENVIRONMENT=dev

# Slack incoming webhook (or any URL) for the alerts created by script 04.
# TOUR_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
