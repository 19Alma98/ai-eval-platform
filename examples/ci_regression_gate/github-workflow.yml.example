# Copy to .github/workflows/rag-regression-gate.yml in your app repo and adapt.
#
# pull_request : evaluate the PR and compare with alias:main (last run that passed on main).
#                Fails (exit 1) when a metric regresses vs the baseline, drops under a floor,
#                or when there is no baseline to compare with (--require-baseline).
#                Posts the gate report as a sticky PR comment.
# push to main : same evaluation; when the gate passes, promote the run to alias:main.
#
# The baseline must survive between runs. Two options:
#   A) Shared OpenGrade server (recommended): set the OPENGRADE_BASE_URL repository variable.
#   B) No server: keep a SQLite store in the GitHub Actions cache. main saves it after
#      every run; PRs restore main's copy (PRs can read caches of their base branch).
#      Caches unused for 7 days are evicted: PRs then fail on baseline.required until the
#      next push to main re-bootstraps the alias.
#
# A PR that intentionally changes the exam (dataset / metrics) cannot be compared with
# main: add the label `opengrade:exam-change` to run it without --require-baseline.
#
# Exit codes: 0 pass | 1 gate failed | 2 config error | 3 infra error

name: RAG regression gate

on:
  pull_request:
    types: [opened, synchronize, reopened, labeled, unlabeled]
  push:
    branches: [main]

concurrency:
  group: rag-gate-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
  pull-requests: write   # sticky PR comment
  checks: write          # JUnit test report

jobs:
  gate:
    runs-on: ubuntu-latest
    env:
      LLM_API_KEY: ${{ secrets.LLM_API_KEY }}            # only for LLM-judge metrics
      OPENGRADE_BASE_URL: ${{ vars.OPENGRADE_BASE_URL }}  # option A; empty → option B
      IS_MAIN: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}
      EXAM_CHANGE: ${{ contains(github.event.pull_request.labels.*.name, 'opengrade:exam-change') }}
    steps:
      - uses: actions/checkout@v4
        with:
          # On PRs, record the PR head commit rather than the temporary merge commit.
          ref: ${{ github.event.pull_request.head.sha || github.sha }}

      - uses: astral-sh/setup-uv@v4
      - run: uv sync   # app deps + opengrade-ai[ui]

      # ---- option B: persist the baseline store in the Actions cache ------------------
      - name: Restore baseline store
        if: env.OPENGRADE_BASE_URL == ''
        uses: actions/cache/restore@v4
        with:
          path: .opengrade/ci.db
          key: opengrade-baseline-${{ github.run_id }}
          restore-keys: opengrade-baseline-

      - name: Evaluate + regression gate
        run: |
          mkdir -p .opengrade
          args=(--config opengrade.yaml --version "${GITHUB_SHA::7}" --baseline alias:main
                --report-md .opengrade/report.md --junit .opengrade/junit.xml)
          if [ -n "$OPENGRADE_BASE_URL" ]; then
            args+=(--base-url "$OPENGRADE_BASE_URL")
          else
            args+=(--backend-store-uri "sqlite+aiosqlite:///$PWD/.opengrade/ci.db")
          fi
          if [ "$IS_MAIN" = "true" ]; then
            args+=(--promote main)
          elif [ "$EXAM_CHANGE" != "true" ]; then
            args+=(--require-baseline)
          fi
          uv run opengrade evaluate "${args[@]}"

      - name: Job summary
        if: always() && hashFiles('.opengrade/report.md') != ''
        run: cat .opengrade/report.md >> "$GITHUB_STEP_SUMMARY"

      - name: PR comment
        if: always() && github.event_name == 'pull_request' && hashFiles('.opengrade/report.md') != ''
        uses: marocchino/sticky-pull-request-comment@v2
        with:
          header: opengrade-gate
          path: .opengrade/report.md

      - name: JUnit report
        if: always() && hashFiles('.opengrade/junit.xml') != ''
        uses: mikepenz/action-junit-report@v4
        with:
          report_paths: .opengrade/junit.xml
          check_name: OpenGrade quality gate

      - name: Save baseline store (main only)
        if: always() && env.OPENGRADE_BASE_URL == '' && env.IS_MAIN == 'true'
        uses: actions/cache/save@v4
        with:
          path: .opengrade/ci.db
          key: opengrade-baseline-${{ github.run_id }}
