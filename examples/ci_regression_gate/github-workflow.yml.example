# Copy to .github/workflows/rag-regression-gate.yml in your app repo and adapt.
#
# pull_request : evaluate the PR and compare against alias:main (last run that passed on main).
#                Fails (exit 1) if any metric regresses vs the baseline or drops under a floor.
# push to main : same evaluation; when the gate passes, promote the run to alias:main.
#
# The baseline must survive between runs. Two options:
#   A) Shared OpenGrade server (recommended): set api_base_url in opengrade.yaml or
#      OPENGRADE_BASE_URL below; no cache needed.
#   B) No server: keep a SQLite store in the GitHub Actions cache. main saves it after
#      every run; PRs restore main's copy (PRs can read caches of their base branch).
#      Caches unused for 7 days are evicted: the next main run then re-bootstraps.
#
# Exit codes: 0 pass | 1 gate failed | 2 config error | 3 infra error

name: RAG regression gate

on:
  pull_request:
  push:
    branches: [main]

concurrency:
  group: rag-gate-${{ github.ref }}
  cancel-in-progress: true

jobs:
  gate:
    runs-on: ubuntu-latest
    env:
      LLM_API_KEY: ${{ secrets.LLM_API_KEY }}          # only if you use LLM-judge metrics
      OPENGRADE_BASE_URL: ${{ vars.OPENGRADE_BASE_URL }} # option A; empty → option B
      IS_MAIN: ${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}
    steps:
      - uses: actions/checkout@v4
        with:
          # On PRs, record the PR head commit rather than the temporary merge commit.
          ref: ${{ github.event.pull_request.head.sha || github.sha }}

      - uses: astral-sh/setup-uv@v4
      - run: uv sync   # app deps + opengrade-ai[ui]

      # ---- option B: persist the baseline store in the Actions cache ------------------
      - name: Restore baseline store
        if: env.OPENGRADE_BASE_URL == ''
        uses: actions/cache/restore@v4
        with:
          path: .opengrade/ci.db
          key: opengrade-baseline-${{ github.run_id }}
          restore-keys: opengrade-baseline-

      - name: Evaluate + regression gate
        run: |
          mkdir -p .opengrade
          args=(--config opengrade.yaml --version "${GITHUB_SHA::7}" --baseline alias:main --json)
          if [ -n "$OPENGRADE_BASE_URL" ]; then
            args+=(--base-url "$OPENGRADE_BASE_URL")
          else
            args+=(--backend-store-uri "sqlite+aiosqlite:///$PWD/.opengrade/ci.db")
          fi
          if [ "$IS_MAIN" = "true" ]; then args+=(--promote main); fi
          set +e
          uv run opengrade evaluate "${args[@]}" > gate.json
          code=$?
          set -e
          # Human-readable summary on the run page (the CLI has no markdown reporter yet).
          python - <<'PY' >> "$GITHUB_STEP_SUMMARY" || true
          import json
          body = json.load(open("gate.json"))
          print(f"## RAG quality gate: {str(body.get('gate')).upper()}\n")
          print(f"[experiment]({body['url']}) · baseline `{body.get('baseline_id')}`\n")
          print("| check | actual | threshold | status |\n|---|---|---|---|")
          for c in body.get("checks", []):
              icon = {"passed": "✅", "failed": "❌"}.get(c["status"], "⚠️")
              print(f"| `{c['metric']}` | {c.get('actual')} | {c.get('threshold')} | {icon} {c['status']} |")
          PY
          exit $code

      - name: Save baseline store (main only)
        if: always() && env.OPENGRADE_BASE_URL == '' && env.IS_MAIN == 'true'
        uses: actions/cache/save@v4
        with:
          path: .opengrade/ci.db
          key: opengrade-baseline-${{ github.run_id }}
